[Desktop Entry]
# Override of /usr/share/applications/discord.desktop. Discord runs only on the
# `home` profile (see niri config.kdl.tmpl). Ozone/Wayland comes from
# ELECTRON_OZONE_PLATFORM_HINT=auto (environment.d/electron.conf); this override
# exists solely to add --enable-wayland-ime so fcitx5 reaches Discord over Wayland
# text-input — without it, once Discord goes native Wayland it gets no input
# method and Vietnamese typing dies there.
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers
GenericName=Internet Messenger
Exec=/usr/bin/discord --enable-wayland-ime
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
Path=/usr/bin
MimeType=x-scheme-handler/discord;
