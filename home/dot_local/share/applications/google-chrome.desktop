[Desktop Entry]
# Override of /usr/share/applications/google-chrome.desktop (translations dropped —
# only the launch behaviour is customised). Google Chrome is Chromium, NOT Electron,
# so it ignores ELECTRON_OZONE_PLATFORM_HINT *and* the chrome-flags.conf mechanism
# (that one is Chromium-launcher only). The Ozone hint therefore has to live here.
#   --ozone-platform-hint=auto  -> native Wayland in a Wayland session
#   --enable-wayland-ime        -> fcitx5 over Wayland text-input
Version=1.0
Name=Google Chrome
GenericName=Web Browser
Comment=Access the Internet
Exec=/usr/bin/google-chrome-stable --ozone-platform-hint=auto --enable-wayland-ime %U
StartupNotify=true
StartupWMClass=google-chrome
Terminal=false
Icon=google-chrome
Type=Application
Categories=Network;WebBrowser;
MimeType=application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/google-chrome;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/google-chrome-stable --ozone-platform-hint=auto --enable-wayland-ime

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/bin/google-chrome-stable --ozone-platform-hint=auto --enable-wayland-ime --incognito
