[Desktop Entry]
Name=Slack
Comment=Slack Desktop
# Ozone/Wayland comes from ELECTRON_OZONE_PLATFORM_HINT=auto (environment.d/electron.conf);
# this override only forces the desktop hint (Slack gates some tray/theme behaviour on it)
# and --enable-wayland-ime so fcitx5 reaches Slack over Wayland text-input.
Exec=env XDG_CURRENT_DESKTOP=GNOME slack --enable-wayland-ime %U
Terminal=false
Type=Application
Icon=slack
StartupWMClass=Slack
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/slack;