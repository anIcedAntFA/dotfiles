[Desktop Entry]
Name=Teams for Linux
# Ozone/Wayland comes from ELECTRON_OZONE_PLATFORM_HINT=auto (environment.d/electron.conf);
# this override only adds --enable-wayland-ime so fcitx5 reaches Teams over Wayland text-input.
Exec=env XDG_CURRENT_DESKTOP=GNOME /opt/teams-for-linux/teams-for-linux --enable-wayland-ime %U
Terminal=false
Type=Application
Icon=teams-for-linux
StartupWMClass=teams-for-linux
Comment=Unofficial Microsoft Teams client for Linux using Electron. It uses the Web App and wraps it as a standalone application using Electron.
MimeType=x-scheme-handler/msteams;
Categories=Chat;Network;Office;
