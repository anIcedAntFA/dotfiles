{
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true
  },
  // Performance: GitLens was the #1 CPU consumer while typing/moving the caret
  // (~3.1s CPU over a 10s "Developer: Show Running Extensions" profile on a large
  // monorepo). These three features recompute on every caret move, so they cost
  // per-keystroke jank; the sidebar, Commit Graph and file history are untouched.
  // See docs/vscode.md § Performance.
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.hovers.enabled": false,
  "git.enableSmartCommit": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.suggest.preview": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.preferences.quoteStyle": "single",
  "[html]": {
    "editor.matchBrackets": "never"
  },
  "[css]": {
    "editor.matchBrackets": "never"
  },
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "auto-close-tag.disableOnLanguage": [],
  "editor.lineHeight": 26,
  "editor.letterSpacing": 0.5,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": true,
  "editor.fontWeight": "300",
  "editor.tabSize": 2,
  "auto-close-tag.activationOnLanguage": [
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb",
    "lang-cfml",
    "cfml",
    "HTML (EEx)",
    "HTML (Eex)",
    "plist"
  ],
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#10b981",
    "terminalCursor.foreground": "#10b981"
  },
  "editor.detectIndentation": false,
  "editor.quickSuggestions": {
    "strings": true
  },
  "explorer.compactFolders": false,
  "terminal.integrated.fontFamily": "JetbrainMono Nerd Font",
  "go.toolsManagement.autoUpdate": true,
  "rust-analyzer.debug.openDebugPane": true,
  "rust-analyzer.assist.expressionFillDefault": "default",
  "rust-analyzer.imports.granularity.enforce": true,
  "editor.accessibilitySupport": "off",
  "cSpell.diagnosticLevel": "Hint",
  "editor.cursorBlinking": "expand",
  "editor.cursorWidth": 4,
  "terminal.integrated.cursorWidth": 2,
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css"
  },
  "errorLens.excludeBySource": ["ts(2779)"],
  "security.workspace.trust.untrustedFiles": "open",
  "window.titleBarStyle": "custom",
  "files.eol": "\r\n",
  "editor.formatOnType": true,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "redhat.telemetry.enabled": false,
  "explorer.confirmDelete": false,
  "editor.minimap.enabled": false,
  "markdownlint.config": {
    "MD033": false
  },
  "markdown-preview-enhanced.previewTheme": "github-light.css",
  "markdown-preview-enhanced.codeBlockTheme": "github.css",
  "mdx.validate.validateDuplicateLinkDefinitions": "warning",
  "mdx.validate.validateFileLinks": "warning",
  "mdx.validate.validateFragmentLinks": "warning",
  "mdx.validate.validateMarkdownFileLinkFragments": "warning",
  "mdx.validate.validateReferences": "warning",
  "window.density.editorTabHeight": "compact",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": true,
  // Format on save is routed per language — there is deliberately no global
  // `editor.defaultFormatter`. A global one pointing at a single-purpose
  // formatter makes every save in a language it can't handle either no-op or
  // pop "Biome is configured as formatter but it cannot format 'X'-files".
  // A repo can override any of these from its own .vscode/settings.json, but
  // ONLY with a per-language block: a language-specific default in *user*
  // settings outranks a plain default set at *workspace* scope.
  "editor.formatOnSave": true,
  "editor.fontSize": 18,
  // Performance: Next Edit Suggestions re-runs on every keystroke and was the #2
  // CPU consumer while typing (Copilot Chat ~2.2s over a 10s profile). Plain
  // inline (ghost-text) completions stay on. See docs/vscode.md § Performance.
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.editor.enableAutoCompletions": true,
  "biome.suggestInstallingGlobally": false,
  "debug.console.lineHeight": -1,
  "workbench.iconTheme": "material-icon-theme",
  "github.copilot.selectedCompletionModel": "",
  "chat.mcp.autostart": "newAndOutdated",
  "debug.javascript.autoAttachFilter": "onlyWithFlag",
  "git.openRepositoryInParentFolders": "never",
  // biome owns JS/TS and JSON; dprint owns the config/prose formats. Both are
  // project-scoped tools — in a project with no biome/dprint config the pinned
  // formatter simply doesn't run. shell/fish pins only bite in workspaces where
  // those (on-demand) extensions are enabled.
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint",
    // dprint keeps prose wrapping as-is, and a hard line break in Markdown is
    // two trailing spaces — don't let the editor eat them.
    "files.trimTrailingWhitespace": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[toml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[fish]": {
    "editor.defaultFormatter": "bmalehorn.vscode-fish"
  },
  // These two YAML flavours keep the schema-aware formatter, since they turn up
  // in projects that have no dprint config. Repos whose CI formats them with
  // dprint (like this dotfiles repo) re-pin them in .vscode/settings.json.
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false
  },
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true
  },
  "accessibility.dimUnfocused.opacity": 0.8,
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Github Light Theme",
  "workbench.preferredDarkColorTheme": "Dracula Theme",
  "workbench.colorTheme": "Dracula Theme",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "settingsSync.ignoredExtensions": ["bierner.markdown-preview-github-styles"],
  "chat.mcp.gallery.enabled": true,
  "docker.extension.enableComposeLanguageServer": false,
  "makefile.configureOnOpen": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  // Opt into the native (Go) TypeScript server, aka tsgo / "TypeScript 7"
  // (typescriptteam.native-preview). Experimental but light in profiling and
  // faster on large monorepos than the JS-based server.
  "js/ts.experimental.useTsgo": true,
  // Custom CSS/JS Loader (be5invis.vscode-custom-css): drives per-color-scheme
  // editor font weight, which VS Code can't do natively. ${userHome} keeps it portable
  // across machines. After install/updates, run "Enable Custom CSS and JS" from
  // the palette — see docs/vscode.md.
  "vscode_custom_css.imports": ["file://${userHome}/.config/Code/User/custom.css"]
}
