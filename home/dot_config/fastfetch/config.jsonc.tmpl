{{- $isLaptop := eq (dig "machine" "work" .) "laptop" -}}
{{- $sub := ternary "laptop" "pc" $isLaptop -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ==========================================================================
  // fastfetch — chezmoi template
  // ==========================================================================
  // Renders to ~/.config/fastfetch/config.jsonc on `chezmoi apply`.
  //
  // Logo: a RANDOM pre-colored Arch ASCII logo each launch, from a per-machine
  // subset. fastfetch renders once (no animation), so the random pick is the
  // "variety". The subset ("pc" vs "laptop") is chosen from the `machine` chezmoi
  // var and passed to the random-logo script; the script + the ASCII files carry
  // the color (command-raw skips fastfetch's own $1-$9 coloring).
  // See docs/fastfetch.md. Per-machine mechanism: docs/adr/0006-*.
  //
  // LAYOUT RULE — no absolute cursor escapes.
  // Four groups drawn with an opening header, a left rail, and a `╰─` foot. The
  // right side is deliberately OPEN: nothing is positioned with `\u001b[NG`,
  // `\u001b[NC` or `\u001b[ND`, and `display.key.width` is NOT used (it emits
  // `\u001b[NG` too). Absolute column moves break as soon as a value outgrows the
  // column they assume — the key gets overwritten or the border lands outside the
  // box. Key columns are aligned by padding the key strings with plain spaces, so
  // a long CPU/GPU/disk string can never disturb anything. See docs/fastfetch.md.
  //
  // COST — this runs on every shell start, so each module is cheap by choice:
  // fastfetch's own detection is free, and the `command` modules below total
  // ~35 ms. Deliberately avoided: `wrangler --version` (477 ms — the version is
  // read from its package.json instead), `pacman -Qm` for an AUR split (134 ms),
  // `ghostty --version` (30 ms — $TERM_PROGRAM_VERSION is free), `mise --version`
  // (208 ms).

  "logo": {
    "type": "command-raw",
    "source": "$HOME/.config/fastfetch/random-logo {{ $sub }}",
    "padding": { "top": 1, "left": 2 },
  },

  "display": {
    "separator": "  ",
  },

  "modules": [
    // --- Identity ---------------------------------------------------------
    "title",
    {
      "type": "custom",
      "format": "{#blue}──────────────────────────────────────────",
    },
    "break",

    // --- System -----------------------------------------------------------
    {
      "type": "custom",
      "format": "{#blue}╭─ {#bold_blue}System{#blue} ────────────────────────────────",
    },
    {
      "type": "os",
      "key": "{#blue}│  {icon}  OS      ",
      "format": "{pretty-name} {arch}",
    },
    {
      "type": "kernel",
      "key": "{#blue}│  {icon}  Kernel  ",
      "format": "{release}",
    },
    {
      // Static "· yay" label on purpose: splitting repo vs AUR needs `pacman -Qm`,
      // which costs 134 ms — nine times the whole of fastfetch.
      "type": "packages",
      "key": "{#blue}│  {icon}  Packages",
      "format": "{all} (pacman · yay)",
    },
    {
      "type": "uptime",
      "key": "{#blue}│  {icon}  Uptime  ",
    },
    { "type": "custom", "format": "{#blue}╰─" },

    // --- Desktop ----------------------------------------------------------
    {
      "type": "custom",
      "format": "{#green}╭─ {#bold_green}Desktop{#green} ───────────────────────────────",
    },
    {
      "type": "wm",
      "key": "{#green}│  {icon}  WM      ",
    },
    {
      // No DE is running (niri + Noctalia), so fastfetch's `de` module is empty.
      "type": "command",
      "key": "{#green}│  {icon}  Shell   ",
      "keyIcon": "\udb80\udf08",
      "text": "noctalia --version 2>/dev/null | sed 's/^noctalia/Noctalia/'",
      "format": "{}",
    },
    {
      // `lm` only detects the daemon (greetd); the greeter it launches is ours.
      "type": "lm",
      "key": "{#green}│  {icon}  Login   ",
      "format": "{pretty-name} + tuigreet",
    },
    {
      // darkman owns the light/dark mode (ADR 0019); Ghostty maps it to
      // `theme = light:latte,dark:dracula`. 3 ms.
      "type": "command",
      "key": "{#green}│  {icon}  Theme   ",
      "keyIcon": "\ue22b",
      "text": "[ \"$(darkman get 2>/dev/null)\" = light ] && echo 'Catppuccin Latte · light' || echo 'Dracula · dark'",
      "format": "{}",
    },
    {
      "type": "display",
      "key": "{#green}│  {icon}  Display ",
      "compactType": "original-with-refresh-rate",
    },
    { "type": "custom", "format": "{#green}╰─" },

    // --- Hardware ---------------------------------------------------------
    {
      "type": "custom",
      "format": "{#yellow}╭─ {#bold_yellow}Hardware{#yellow} ──────────────────────────────",
    },
    {
      "type": "cpu",
      "key": "{#yellow}│  {icon}  CPU     ",
      "format": "{name} ({core-types}) @ {freq-max}",
    },
    {
      "type": "gpu",
      "key": "{#yellow}│  {icon}  GPU     ",
      "format": "{vendor} {name}",
    },
    {
      "type": "memory",
      "key": "{#yellow}│  {icon}  Memory  ",
    },
    {
      "type": "swap",
      "key": "{#yellow}│  {icon}  Swap    ",
    },
    {
      "type": "disk",
      "key": "{#yellow}│  {icon}  Disk    ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}",
    },
{{- if $isLaptop }}
    {
      "type": "battery",
      "key": "{#yellow}│  {icon}  Battery ",
    },
{{- end }}
    { "type": "custom", "format": "{#yellow}╰─" },

    // --- Dev --------------------------------------------------------------
    {
      "type": "custom",
      "format": "{#magenta}╭─ {#bold_magenta}Dev{#magenta} ───────────────────────────────────",
    },
    {
      // One row for the whole terminal stack. Ghostty exports
      // $TERM_PROGRAM_VERSION, so its version is free; fish + starship are 2 ms
      // each. ~5 ms total.
      "type": "command",
      "key": "{#magenta}│  {icon}  Terminal",
      "keyIcon": "\ue795",
      "text": "printf '%s %s · fish %s · starship %s' \"${TERM_PROGRAM:-terminal}\" \"${TERM_PROGRAM_VERSION%%-*}\" \"$(fish --version | sed 's/.*version //')\" \"$(starship --version | head -1 | sed 's/starship //')\"",
      "format": "{}",
    },
    {
      "type": "terminalfont",
      "key": "{#magenta}│  {icon}  Font    ",
    },
    {
      "type": "command",
      "key": "{#magenta}│  {icon}  Editor  ",
      "keyIcon": "\udb85\uddae",
      "text": "printf 'Zed %s · git %s' \"$(zeditor --version | sed 's/^Zed //; s/ –.*//')\" \"$(git --version | sed 's/git version //')\"",
      "format": "{}",
    },
    {
      // wrangler's version is read from the package.json mise installed, not from
      // `wrangler --version` (a Node CLI — 477 ms).
      "type": "command",
      "key": "{#magenta}│  {icon}  Runtime ",
      "keyIcon": "\ued0d",
      "text": "printf 'node %s · go %s · bun %s · wrangler %s' \"$(node --version | tr -d v)\" \"$(go version | cut -d' ' -f3 | cut -c3-)\" \"$(bun --version)\" \"$(sed -n 's/.*\"version\": *\"\\([^\"]*\\)\".*/\\1/p' \"${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/wrangler/latest/lib/node_modules/wrangler/package.json\" 2>/dev/null | head -1)\"",
      "format": "{}",
    },
    { "type": "custom", "format": "{#magenta}╰─" },

    "break",
    "colors",
  ],
}
